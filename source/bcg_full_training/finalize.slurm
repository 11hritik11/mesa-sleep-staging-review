#!/bin/bash
#SBATCH --job-name=mesa-full-report
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=12:00:00
#SBATCH --output=logs/mesa-full-report-%j.out
#SBATCH --error=logs/mesa-full-report-%j.err
set -euo pipefail
cd /home/rdb200/nsrr-setup
export PYTHONPATH=/home/rdb200/nsrr-setup/.deps-bcg
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=4 MPLBACKEND=Agg
.venv-transformer/bin/python bcg_full_training/verify_source.py "$1/source_checksums.json"
.venv-transformer/bin/python -u bcg_full_training/finalize.py --prepared "$1/prepared" --trees "$1/trees" --temporal "$1/temporal" --output "$1/results" --threads 4
